<Window x:Class="HelloWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrossWin WPF sample" Width="460" Height="300">
    <StackPanel Margin="20">
        <TextBlock x:Name="Counter" Text="Clicks: 0" FontSize="20" />
        <Button Content="Click me" Width="120" Margin="0,12" HorizontalAlignment="Left" Click="OnClick" />
        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding Note}" Foreground="SteelBlue" Margin="0,8" />
        <Rectangle Height="40" Margin="0,8">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Orange" Offset="0" />
                    <GradientStop Color="MediumPurple" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </StackPanel>
</Window>
