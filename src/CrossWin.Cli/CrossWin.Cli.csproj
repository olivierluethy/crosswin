<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host-native CLI (macOS/Linux). Runs the user's app under Wine; never runs inside Wine itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>crosswin</AssemblyName>
    <RootNamespace>CrossWin</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The bootstrap installs only the latest LTS SDK; let the CLI run on it. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Gui/index.html" LogicalName="gui/index.html" />
    <EmbeddedResource Include="Mobile/preview.html" LogicalName="preview.html" />
    <EmbeddedResource Include="Mobile/Fixtures/crosswin_io/lib/io.dart" LogicalName="crosswin_io/io.dart" />
    <EmbeddedResource Include="Mobile/Fixtures/crosswin_io/lib/flutter.dart" LogicalName="crosswin_io/flutter.dart" />
  </ItemGroup>
</Project>
